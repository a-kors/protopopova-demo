---
import { Image } from 'astro:assets';
import c1 from '../assets/gallery/g07.jpg';
import c2 from '../assets/gallery/g08.jpg';
import c3 from '../assets/gallery/g09.jpg';
import { camp } from '../data/master';
import CtaGroup from './CtaGroup.astro';
---

<section id="camp" class="camp">
  <div class="wrap grid">
    <div class="copy" data-reveal>
      <span class="section-eyebrow">Выездная детская программа</span>
      <h2>{camp.title}</h2>
      <p class="lead">{camp.text}</p>
      <p class="muted">
        Набор открыт. Даты ближайшей смены и&nbsp;условия подскажет служба заботы.
      </p>
      <CtaGroup label="Узнать о программе" variant="secondary" />
    </div>

    <div class="pics" data-reveal data-reveal-delay="120">
      <Image src={c1} alt="Занятие под навесом в лагере «Мир моей мечты»" widths={[400, 640]} sizes="(max-width: 860px) 45vw, 300px" format="webp" quality={70} loading="lazy" class="p p1" />
      <Image src={c2} alt="Дети за творческим заданием на свежем воздухе" widths={[400, 640]} sizes="(max-width: 860px) 45vw, 300px" format="webp" quality={70} loading="lazy" class="p p2" />
      <Image src={c3} alt="Группа детей и взрослых в Белокурихе" widths={[600, 960]} sizes="(max-width: 860px) 92vw, 620px" format="webp" quality={70} loading="lazy" class="p p3" />
    </div>
  </div>
</section>

<style>
  .camp {
    background: var(--bg-soft);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  h2 {
    margin: 12px 0 22px;
  }
  .lead {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink);
    margin-bottom: 14px;
  }
  .muted {
    color: var(--ink-muted);
    margin-bottom: 28px;
  }
  .pics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .pics :global(.p) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    display: block;
  }
  .pics :global(.p1),
  .pics :global(.p2) {
    aspect-ratio: 3 / 4;
  }
  .pics :global(.p3) {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
